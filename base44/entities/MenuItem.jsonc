{
  "name": "MenuItem",
  "properties": {
    "category": {
      "default": "tacos",
      "enum": [
        "tacos",
        "especiales",
        "bebidas",
        "complementos"
      ],
      "title": "Categoría",
      "type": "string"
    },
    "description": {
      "title": "Descripción",
      "type": "string"
    },
    "image_url": {
      "title": "Imagen",
      "type": "string"
    },
    "is_available": {
      "default": true,
      "title": "Disponible",
      "type": "boolean"
    },
    "is_featured": {
      "default": false,
      "title": "Destacado",
      "type": "boolean"
    },
    "name": {
      "title": "Nombre",
      "type": "string"
    },
    "order_index": {
      "default": 0,
      "title": "Orden",
      "type": "number"
    },
    "os_id": {
      "description": "Vincula este producto del menú público con su contraparte en El Pecado OS. Cuando está lleno, la disponibilidad (agotado/disponible) se sincroniza automáticamente desde el inventario real; cuando está vacío, este producto es solo del menú público y su disponibilidad se controla manualmente.",
      "title": "ID en El Pecado OS",
      "type": "string"
    },
    "price": {
      "title": "Precio",
      "type": "number"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "type": "object"
}
