  "name": "Invitation",
  "properties": {
    "email": {
      "title": "Correo invitado",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expira",
      "type": "string"
    },
    "invited_by": {
      "title": "Invitado por",
      "type": "string"
    },
    "role": {
      "enum": [
        "admin",
        "mesero"
      ],
      "title": "Rol asignado",
      "type": "string"
    },
    "status": {
      "default": "pendiente",
      "enum": [
        "pendiente",
        "activado",
        "expirado"
      ],
      "title": "Estado",
      "type": "string"
    },
    "token": {
      "title": "Token de acceso",
      "type": "string"
    }
  },
  "required": [
    "email",
    "role",
    "token"
  ],
